@model CategoriesVm
@{ ViewData["Title"] = "Categories"; }
<h1>Categories: @Model.Event.Name</h1>
<div class="card mb-4"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Distance</th><th>Price</th><th></th></tr></thead><tbody>
@foreach (var c in Model.Categories)
{
    <tr><td>@c.Name</td><td>@c.DistanceKm km</td><td>R @c.Price.ToString("0.00")</td>
    <td class="text-end"><form asp-action="DeleteCategory" method="post" class="d-inline"><input type="hidden" name="eventId" value="@Model.Event.EventId" /><input type="hidden" name="categoryId" value="@c.CategoryId" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>
}
@if (!Model.Categories.Any()) { <tr><td colspan="4" class="text-muted">No categories yet.</td></tr> }
</tbody></table></div>
<div class="card p-3"><h4>Add a category</h4>
<form asp-action="AddCategory" method="post" class="row g-2 align-items-end">
    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
    <div class="col-md-5"><label class="form-label small">Name (e.g. 10km Senior)</label><input name="Name" class="form-control" required /></div>
    <div class="col-md-3"><label class="form-label small">Distance (km)</label><input name="DistanceKm" type="number" step="0.1" min="0" class="form-control" required /></div>
    <div class="col-md-2"><label class="form-label small">Price (R)</label><input name="Price" type="number" step="0.01" min="0" class="form-control" required /></div>
    <div class="col-md-2"><button class="btn btn-rd w-100">Add</button></div>
</form></div>
<a class="btn btn-link mt-3" asp-action="Events">&larr; Back to events</a>
