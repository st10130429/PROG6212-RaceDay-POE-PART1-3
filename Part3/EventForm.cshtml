@model EventFormVm
@{ ViewData["Title"] = Model.EventId == 0 ? "New Event" : "Edit Event"; }
<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4">
<h2 class="mb-3">@ViewData["Title"]</h2>
<form asp-action="SaveEvent" method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" asp-for="EventId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger small"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label">Date &amp; time</label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate" class="text-danger small"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label">Event type</label>
            <select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select><span asp-validation-for="EventType" class="text-danger small"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1" class="form-control" /><span asp-validation-for="DistanceKm" class="text-danger small"></span></div>
    </div>
    <div class="mb-3"><label asp-for="Banner" class="form-label">Event banner image</label>
        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl)) { <div class="mb-2"><img src="@Model.ExistingBannerUrl" class="event-banner" style="max-width:320px;border-radius:.5rem" alt="Current banner" /></div> }
        <input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" /><span asp-validation-for="Banner" class="text-danger small"></span></div>
    <button class="btn btn-rd">Save event</button> <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
</form></div></div></div>
